# fixture:
#   version: "4.0"
#   category: decode
#   description: "Delimiter decoding – tab and pipe delimiter parsing, delimiter-aware value splitting"
# name: treats a delimiter inside a closed or unclosed mid-token quote span as quoted
# specSection: "5.2"
# minSpecVersion: "4.2"
# "expected-json": "{\"k\":[\"a\\\"b,c\\\"\",\"d\"],\"u\":[\"x\\\"y,z\"],\"v\":[\"x\\\\\\\"y,z\"]}"
# ---
k[2]: a"b,c",d
u[1]: x"y,z
v[1]: x\"y,z