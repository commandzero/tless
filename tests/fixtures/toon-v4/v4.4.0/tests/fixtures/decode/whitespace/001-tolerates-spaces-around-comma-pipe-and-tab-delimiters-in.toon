#   description: Whitespace tolerance in decoding – surrounding spaces around delimiters and values
# name: "tolerates spaces around comma, pipe, and tab delimiters in inline arrays"
# specSection: "12"
# "expected-json": "{\"comma\":[\"a\",\"b\",\"c\"],\"pipe\":[\"a\",\"b\",\"c\"],\"tab\":[\"a\",\"b\",\"c\"]}"
