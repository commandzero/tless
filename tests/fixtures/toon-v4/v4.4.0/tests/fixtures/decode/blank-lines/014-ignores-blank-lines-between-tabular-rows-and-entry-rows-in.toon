# fixture:
#   version: "4.0"
#   category: decode
#   description: Blank line handling – a blank line inside a header span errors in strict mode and is ignored in non-strict mode; blank lines elsewhere are ignored
# name: ignores blank lines between tabular rows and entry rows in non-strict mode
# options:
#   strict: false
# specSection: "14.4"
# minSpecVersion: "4.4"
# "expected-json": "{\"items\":[{\"id\":1,\"name\":\"Ada\"},{\"id\":2,\"name\":\"Bob\"}],\"m\":{\"a\":{\"v\":1},\"b\":{\"v\":2}}}"
# ---
items[2]{id,name}:
  1,Ada

  2,Bob
m[2:]{v}:
  a: 1

  b: 2