# fixture:
#   version: "4.0"
#   category: decode
#   description: "Indentation validation and its non-strict recoveries – non-multiple indentation, tab characters, custom indentSizes"
# name: adopts the depth of a jumped first line in non-strict mode
# options:
#   strict: false
# specSection: "14.4"
# minSpecVersion: "4.4"
# "expected-json": "{\"a\":{\"b\":{\"x\":1},\"c\":2},\"items\":[1,2],\"t\":[{\"a\":1}],\"m\":{\"k\":{\"v\":2}},\"l\":[{\"k\":{\"x\":1}}]}"
# ---
a:
    b:
      x: 1
    c: 2
items[2]:
    - 1
    - 2
t[1]{a}:
    1
m[1:]{v}:
    k: 2
l[1]:
  - k:
        x: 1