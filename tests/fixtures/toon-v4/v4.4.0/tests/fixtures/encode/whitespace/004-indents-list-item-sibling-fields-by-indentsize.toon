# fixture:
#   version: "4.0"
#   category: encode
#   description: "Whitespace and formatting invariants – no trailing spaces, no trailing newlines"
# name: indents list-item sibling fields by indentSize
# options:
#   indentSize: 4
# specSection: "10"
# "input-json": "{\"a\":[{\"b\":1,\"c\":2},1]}"
# ---
a[2]:
    - b: 1
        c: 2
    - 1