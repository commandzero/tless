# fixture:
#   version: "4.0"
#   category: encode
#   description: Keyed tabular encoding – objects whose values are uniform objects collapse into keyed headers with entry rows
# name: encodes objects of uniform objects in keyed tabular form
# specSection: "9.5"
# "input-json": "{\"servers\":{\"alpha\":{\"host\":\"a.example.com\",\"port\":8080},\"beta\":{\"host\":\"b.example.com\",\"port\":9090}}}"
# ---
servers[2:]{host,port}:
  alpha: a.example.com,8080
  beta: b.example.com,9090