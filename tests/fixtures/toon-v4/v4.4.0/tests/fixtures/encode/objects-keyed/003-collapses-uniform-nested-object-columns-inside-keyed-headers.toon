# fixture:
#   version: "4.0"
#   category: encode
#   description: Keyed tabular encoding – objects whose values are uniform objects collapse into keyed headers with entry rows
# name: collapses uniform nested object columns inside keyed headers
# specSection: "9.5"
# "input-json": "{\"regions\":{\"eu\":{\"name\":\"Europe\",\"geo\":{\"lat\":50,\"lon\":10}},\"us\":{\"name\":\"America\",\"geo\":{\"lat\":40,\"lon\":-100}}}}"
# ---
regions[2:]{name,geo{lat,lon}}:
  eu: Europe,50,10
  us: America,40,-100