# fixture:
#   version: "4.0"
#   category: encode
#   description: "Delimiter options – tab and pipe delimiters, delimiter-aware quoting"
# name: encodes nested arrays with pipe delimiter
# options:
#   delimiter: |
# specSection: "11"
# "input-json": "{\"pairs\":[[\"a\",\"b\"],[\"c\",\"d\"]],\"items\":[{\"k\":[[1,{\"x\":1}]]}]}"
# ---
pairs[2|]:
  - [2|]: a|b
  - [2|]: c|d
items[1|]:
  - k[1|]:
      - [2|]:
        - 1
        - x: 1