# fixture:
#   version: "4.0"
#   category: encode
#   description: "Primitive value encoding – strings, numbers, booleans, null"
# name: quotes single hyphen and hyphen-space string as object values
# specSection: "7.2"
# note: Either would otherwise read as a list item marker
# "input-json": "{\"marker\":\"-\",\"note\":\"- item\"}"
# ---
marker: "-"
note: "- item"