#   category: encode
#   description: Arrays of objects encoding – list form for non-uniform objects and complex structures
# name: preserves field order in list items
# specSection: "10"
# "input-json": "{\"items\":[{\"nums\":[1,2,3],\"name\":\"Ada\"},{\"name\":\"Ada\",\"nums\":[1,2,3]}]}"
# ---
items[2]:
  - nums[3]: 1,2,3
    name: Ada
  - name: Ada
    nums[3]: 1,2,3